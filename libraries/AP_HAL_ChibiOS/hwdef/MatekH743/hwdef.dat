# hw definition file for custom STM32H743VIT6 DevKit
# Based on Matek H743-WING layout stripped to bare core + ICM20602 on SPI4

# MCU class and specific type
MCU STM32H7xx STM32H743xx

# Custom Board ID (Reusing MATEKH743 ID or custom assigned ID)
APJ_BOARD_ID AP_HW_MATEKH743

# Crystal frequency, setup to use external oscillator (8MHz typical for dev kits)
OSCILLATOR_HZ 8000000

FLASH_SIZE_KB 2048

# Bootloader takes first sector (128KB)
FLASH_RESERVE_START_KB 128

# ChibiOS system timer configuration
STM32_ST_USE_TIMER 12
define CH_CFG_ST_RESOLUTION 16

# ------------------------------------------------------------------------------
# Core Debug & Communication Interfaces
# ------------------------------------------------------------------------------

# USB OTG1
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1

# SWD Debug
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

# Serial UART Ordering
SERIAL_ORDER OTG1 UART7 USART1 USART2 USART3 UART8 UART4 USART6 OTG2

# USART1 (telem2)
PA10 USART1_RX USART1
PA9  USART1_TX USART1

# USART2 (GPS1)
PD5 USART2_TX USART2
PD6 USART2_RX USART2

# USART3 (GPS2)
PD9 USART3_RX USART3
PD8 USART3_TX USART3

# UART4 (spare)
PB9 UART4_TX UART4
PB8 UART4_RX UART4

# USART6 (RC input / Serial7)
PC7 USART6_RX USART6 NODMA ALT(1)
PC6 USART6_TX USART6 NODMA

# UART7 (telem1)
PE7 UART7_RX UART7
PE8 UART7_TX UART7
PE10 UART7_CTS UART7
PE9  UART7_RTS UART7

# UART8 (spare)
PE0 UART8_RX UART8
PE1 UART8_TX UART8

# CAN Bus
PD0 CAN1_RX CAN1
PD1 CAN1_TX CAN1
PD3 GPIO_CAN1_SILENT OUTPUT PUSHPULL SPEED_LOW LOW GPIO(70)

# ------------------------------------------------------------------------------
# I2C Bus Configuration
# ------------------------------------------------------------------------------
I2C_ORDER I2C2 I2C1

# I2C1
PB6 I2C1_SCL I2C1
PB7 I2C1_SDA I2C1

# I2C2
PB10 I2C2_SCL I2C2
PB11 I2C2_SDA I2C2

# Compass Probing
define AP_COMPASS_PROBING_ENABLED 1
define HAL_I2C_INTERNAL_MASK 0
define HAL_COMPASS_AUTO_ROT_DEFAULT 2

# ------------------------------------------------------------------------------
# SPI Buses Configuration
# ------------------------------------------------------------------------------

# SPI1 Pinout (Reserved for expansion)
PA5 SPI1_SCK SPI1
PA6 SPI1_MISO SPI1
PD7 SPI1_MOSI SPI1

# SPI2 Pinout (Reserved for expansion)
PB13 SPI2_SCK SPI2
PB14 SPI2_MISO SPI2
PB15 SPI2_MOSI SPI2

# SPI3 Pinout (Reserved for expansion)
PB3 SPI3_SCK SPI3
PB4 SPI3_MISO SPI3
PB5 SPI3_MOSI SPI3

# SPI4 Dedicated for IMU (ICM20602)
PE11 IMU2_CS CS
PE12 SPI4_SCK SPI4
PE13 SPI4_MISO SPI4
PE14 SPI4_MOSI SPI4

# SPI Device Registry - Only ICM20602 enabled
SPIDEV icm20602  SPI4 DEVID1 IMU2_CS  MODE3  1*MHZ  4*MHZ

DMA_NOSHARE SPI4*

# IMU Driver Configuration
IMU Invensense SPI:icm20602 ROTATION_ROLL_180_YAW_270
define HAL_DEFAULT_INS_FAST_SAMPLE 1

# ------------------------------------------------------------------------------
# Storage & Peripherals
# ------------------------------------------------------------------------------

# microSD support via SDMMC1
PC8 SDMMC1_D0 SDMMC1
PC9 SDMMC1_D1 SDMMC1
PC10 SDMMC1_D2 SDMMC1
PC11 SDMMC1_D3 SDMMC1
PC12 SDMMC1_CK SDMMC1
PD2 SDMMC1_CMD SDMMC1

define HAL_OS_FATFS_IO 1

# Flash Storage
define HAL_STORAGE_SIZE 32768
STORAGE_FLASH_PAGE 14

# Status LEDs
PE3 LED0 OUTPUT LOW GPIO(90) # Blue
PE4 LED1 OUTPUT LOW GPIO(91) # Green
define AP_NOTIFY_GPIO_LED_2_ENABLED 1
define HAL_GPIO_A_LED_PIN 91
define HAL_GPIO_B_LED_PIN 90

# Beeper
PA15 TIM2_CH1 TIM2 GPIO(32) ALARM

# General Outputs / Motors
PB0  TIM8_CH2N TIM8  PWM(1)  GPIO(50)
PB1  TIM8_CH3N TIM8  PWM(2)  GPIO(51)
PA0  TIM5_CH1  TIM5  PWM(3)  GPIO(52)
PA1  TIM5_CH2  TIM5  PWM(4)  GPIO(53)
PA2  TIM5_CH3  TIM5  PWM(5)  GPIO(54)
PA3  TIM5_CH4  TIM5  PWM(6)  GPIO(55)
PD12 TIM4_CH1  TIM4  PWM(7)  GPIO(56)
PD13 TIM4_CH2  TIM4  PWM(8)  GPIO(57)
PD14 TIM4_CH3  TIM4  PWM(9)  GPIO(58)
PD15 TIM4_CH4  TIM4  PWM(10) GPIO(59)
PE5  TIM15_CH1 TIM15 PWM(11) GPIO(60)
PE6  TIM15_CH2 TIM15 PWM(12) GPIO(61)
PA8  TIM1_CH1  TIM1  PWM(13) GPIO(62)

DMA_PRIORITY S*

# Enable ABIN build for ArduPilot bootloader flashing
env BUILD_ABIN True
